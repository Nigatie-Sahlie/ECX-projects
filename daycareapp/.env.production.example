# Copy to .env.production on the production host. Never commit the populated file.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_KEY=replace-with-at-least-32-random-characters
APP_ORIGIN=https://your-domain.example

# Leave SMTP disabled until these values are configured.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_FROM=no-reply@your-domain.example
SMTP_USERNAME=
SMTP_PASSWORD=
