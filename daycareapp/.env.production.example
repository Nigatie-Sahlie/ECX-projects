# Copy to .env.production on the EC2 host. Never commit the populated file.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_KEY=replace-with-at-least-32-random-characters
APP_ORIGIN=http://REPLACE-WITH-YOUR-EC2-PUBLIC-DNS

# Optional: password reset emails stay disabled until SMTP is configured.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_FROM=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
